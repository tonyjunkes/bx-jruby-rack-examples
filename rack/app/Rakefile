require_relative 'lib/boot'
require 'rake'

namespace :db do
    desc 'Apply the application migrations'
    task :migrate do
        ActiveRecord::MigrationContext.new(File.join(APP_ROOT, 'db/migrate')).migrate
    end

    desc 'Seed sample records (only called for a new database)'
    task :seed do
        load File.join(APP_ROOT, 'db/seeds.rb')
    end
end

namespace :demo do
    desc 'Prepare a new demo or migrate an existing one without replacing data'
    task :prepare do
        new_database = !File.exist?(DATABASE_PATH)
        Rake::Task['db:migrate'].invoke
        Rake::Task['db:seed'].invoke if new_database
    end
end
